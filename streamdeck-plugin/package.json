{
  "name": "opencode-streamdeck",
  "version": "1.0.0",
  "description": "Display your opencode usage stats on your Stream Deck",

  "scripts": {
    "build": "rollup -c && node scripts/sync.mjs",
    "watch": "rollup -c -w --watch.onEnd=\"node scripts/sync.mjs && streamdeck restart com.chrisfryer.opencode-stats\"",
    "link": "streamdeck link .sdPlugin",
    "sync": "node scripts/sync.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@elgato/streamdeck": "^1.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^26.1.2",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0"
  }
}
