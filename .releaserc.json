{
  "repositoryUrl": "https://github.com/cfryerdev/opencode-streamdeck-stats.git",
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/exec",
      {
        "analyzeCommitsCmd": "echo patch"
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cd opencode-plugin && npm version ${nextRelease.version} --git-tag-version false && mkdir -p ../dist && npm pack --pack-destination ../dist"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "cd opencode-plugin && NODE_AUTH_TOKEN= npm publish --provenance --access public"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.tgz",
            "label": "npm package"
          }
        ]
      }
    ]
  ]
}
